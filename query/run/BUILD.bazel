load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "lib",
    srcs = glob(["src/**/*.py"]),
    imports = ["src"],
    visibility = ["//query:__subpackages__"],
)

py_binary(
    name = "bin",
    srcs = ["src/bazelutil/query/main.py"],
    legacy_create_init = False,
    main = "src/bazelutil/query/main.py",
    python_version = "3.13",
    visibility = ["//visibility:public"],
    deps = [":lib"],
)
